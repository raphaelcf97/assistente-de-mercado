# Copie este arquivo para .env.local e preencha os valores.
# Veja SETUP.md para o passo a passo de onde conseguir cada um.

# Supabase (Configurações do projeto → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticação por PIN
APP_PIN=
# String aleatória longa, gerada uma vez (ex: openssl rand -hex 32)
APP_SESSION_SECRET=

# Opcional: protege o endpoint de cron contra chamadas externas.
# Se definido, configure o mesmo valor em Vercel (Settings > Cron Jobs usa isso automaticamente).
CRON_SECRET=
